#!/usr/bin/env python
# encoding: utf-8

def build(bld):
    vehicle = bld.path.name
    bld.ap_stlib(
        name=vehicle + '_libs',
        ap_vehicle=vehicle,
        ap_libraries=bld.ap_common_vehicle_libraries() + [
            'AP_Motors',
            'AP_Avoidance',
            'AP_AdvancedFailsafe',
            'AP_SmartRTL',
            'AP_WheelEncoder',
            'AP_Winch',
            'AP_Follow',
            'AP_LTM_Telem',
            'AP_Devo_Telem',
            'AP_KDECAN',
            'AP_SurfaceDistance'
        ],
    )

    bld.ap_program(
        program_name='ardurocket',
        program_groups=['bin', 'rocket'],
        use=vehicle + '_libs',
        defines=['FRAME_CONFIG=ROCKET_FRAME'],
        )